# Tic Tac Toe backend — copy to backend/.env and edit as needed.
#
# All variables are optional; sensible defaults are baked into server.js.

# Port the Express + Socket.IO server listens on.
PORT=3001

# Allowed origin(s) for browser clients. Comma-separated for multiple.
# Use "*" only for local dev. Tighten this in production.
CORS_ORIGIN=http://localhost:5173

# "development" | "production". Production mode trims log output.
NODE_ENV=development
